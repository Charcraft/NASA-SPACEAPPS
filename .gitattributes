# Normalizar finales de línea para que el repo funcione igual en Windows, macOS y Linux
* text=auto eol=lf

# Scripts de Windows: no convertir
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.pdf binary

# Lockfile: no generar diffs ruidosos
pnpm-lock.yaml merge=binary
