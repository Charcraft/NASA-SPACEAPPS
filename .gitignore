# Dependencias
node_modules/
.pnpm-store/

# Build
.next/
out/
dist/
build/

# Entorno
.env
.env.local
.env.*.local

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Archivos temporales de Office (bloqueos de PowerPoint/Word/Excel)
~$*

# Caché
.cache/
.turbo/
*.tsbuildinfo
__pycache__/
*.py[cod]
*$py.class

# Datos temporales del hackathon
temp/
tmp/

# Bitácoras personales de IA (no forman parte del entregable público)
Uso de IA-Personal/

# Pruebas locales de cada integrante (ver docs/03-plan/01-plan-7-dias.md)
practicas-locales/

# Capturas y archivos sueltos
*.png
*.jpg
!docs/**/*.png
!docs/**/*.jpg
# Iconos de la PWA (se sirven estáticamente y deben versionarse)
!public/icons/*.png

# Cache de exploracion de datos
scripts/.osdr-humano.json

# Snapshot durable del central (runtime, no se versiona)
data/central/

# Lotes recibidos por el endpoint "Tierra" (runtime, no se versiona)
data/tierra/

# Skills instaladas localmente (se generan con scripts/instalar-todo)
.opencode/skills/
.claude/skills/
.cursor/skills/

# Icono de carpeta local (lo genera scripts/crear-acceso-directo)
desktop.ini
